# Copia este archivo a .env y pon tus claves de Stripe (modo prueba)
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
# Precio en centavos (ej: 1695 -> €16.95)
PRICE_CENTS=1695
# Gastos de envío por ejemplar en centavos (ej: 450 -> €4.50)
SHIPPING_CENTS=450
CURRENCY=eur
